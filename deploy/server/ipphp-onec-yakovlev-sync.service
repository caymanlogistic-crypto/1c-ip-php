[Unit]
Description=Read and archive 1C Yakovlev in the common application
After=docker.service ipphp-onec-network.service
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=45min
ExecStart=/usr/bin/docker exec --user www-data --workdir /opt/app ipphp-ui-app-1 php bin/sync-yakovlev-hourly.php
